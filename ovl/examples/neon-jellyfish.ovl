// Neon Jellyfish - A beautiful ambient overlay
// Glowing wireframe jellyfish floating across the screen

@overlay "Neon Jellyfish"
  type: ambient
  size: fullscreen
  blend: screen

  @creature jellyfish
    style: wireframe
    glow: cyan 0.8
    color: cyan
    count: 3
    movement: float, drift
    speed: slow
    opacity: 80%

  @particles bubbles
    count: 40
    color: cyan
    opacity: 30%
    direction: up
    speed: slow
    shape: circle

  @behavior
    on idle: drift slowly
    on stressed: pulse gently
    on break: flare display
