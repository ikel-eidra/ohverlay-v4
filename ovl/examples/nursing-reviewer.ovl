// Board Exam Reviewer - Philippine Nursing Licensure
// Questions appear as glowing overlays every 5 minutes

@overlay "Nursing Board Reviewer"
  type: productivity
  blend: screen

  @quiz
    subject: Nursing Licensure Exam
    interval: 5m
    display: 15s
    shuffle: true
    glow: cyan 0.8

    @question "Anatomy: Heart Chambers"
      text: How many chambers does the human heart have?
      options: Two, Three, Four, Five
      answer: 2    // 0-indexed (Four)

    @question "Pharmacology: Paracetamol"
      text: What is the generic name of Tylenol?
      options: Ibuprofen, Acetaminophen, Aspirin, Naproxen
      answer: 1

    @question "Fundamentals: Vital Signs"
      text: What is the normal adult resting heart rate?
      options: 40-60 bpm, 60-100 bpm, 100-120 bpm, 80-140 bpm
      answer: 1

    @question "Med-Surg: Diabetes"
      text: Which type of diabetes is insulin-dependent?
      options: Type 1, Type 2, Gestational, Pre-diabetes
      answer: 0

    @question "Pediatric: APGAR Score"
      text: APGAR scoring is done at what intervals after birth?
      options: 1 and 5 minutes, 2 and 10 minutes, 5 and 10 minutes, 1 and 10 minutes
      answer: 0

    @question "Maternal: Fundal Height"
      text: At 20 weeks, the fundal height is at the level of the?
      options: Symphysis pubis, Umbilicus, Xiphoid process, Costal margin
      answer: 1

    @question "Psych: Defense Mechanisms"
      text: Attributing your own unacceptable feelings to others is called?
      options: Denial, Rationalization, Projection, Displacement
      answer: 2

    @question "Community Health: DOH"
      text: What does DOH stand for in the Philippines?
      options: Department of Health, Division of Hospitals, District of Healthcare, Department of Hygiene
      answer: 0
