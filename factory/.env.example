# ============================================================
# OHVERLAY FACTORY - Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# AI Agent API Keys (free tiers)
GROQ_API_KEY=your_groq_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Database (auto-configured by Docker Compose)
DATABASE_URL=postgresql://ohverlay:ohverlay_secret@factory-db:5432/ohverlay_factory
REDIS_URL=redis://factory-cache:6379/0

# Factory Settings
FACTORY_URL=https://ohverlay.com
FACTORY_PORT=8400
FACTORY_DEBUG=false

# n8n Automation
N8N_PASSWORD=change_this_password
N8N_WEBHOOK_KEY=your_webhook_secret

# Optional: Custom domain
# FACTORY_HOST=0.0.0.0
